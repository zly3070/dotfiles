# i3status configuration file.
# By default, i3status looks for configuration files in the following order:
#    ~/.config/i3status/config (or $XDG_CONFIG_HOME/i3status/config if set)
#    /etc/xdg/i3status/config (or $XDG_CONFIG_DIRS/i3status/config if set)
#    ~/.i3status.conf
#    /etc/i3status.conf


general {
        colors = true
        interval = 2      # 刷新率
        color_good = "#a3be8c"
        color_degraded = "#ebcb8b"
        color_bad = "#bf616a"
}

order += "wireless _first_"
order += "cpu_temperature 0"
order += "battery all"
order += "disk /"
order += "memory"
order += "volume master"
order += "tztime local"

wireless _first_ {
        format_up = "W: %essid (%quality)"
        format_down = "W: down"
}

cpu_temperature 0 {
        format = "T: %degrees °C"
        max_threshold = 80
        path = "/sys/class/thermal/thermal_zone0/temp"
}

battery all {
        format = "%status %percentage %remaining"
}

disk "/" {
        format = "%avail"
}

memory {
        format = "%available"
        # threshold_degraded = "80%"
        # format_degraded = "Mem: %used !"
}

volume master {
        format = "♪: %volume"
        # format_muted = "♪: 0% (Muted)"
        device = "pulse"
        mixer = "Master"
        mixer_idx = 0
}

tztime local {
        format = "%a %Y-%m-%d %H:%M"
}
